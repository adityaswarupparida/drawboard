{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-drawboard",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drawboard-db",
      // Replace with the id printed by `npx wrangler d1 create drawboard-db` before deploying.
      "database_id": "def6c4b9-885b-48d3-a022-72e9f78c7cc4",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CanvasAgent", "class_name": "CanvasAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CanvasAgent"] }],
  "workflows": [
    { "name": "design-review", "binding": "DESIGN_REVIEW", "class_name": "DesignReviewWorkflow" }
  ]
}
